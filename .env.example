# Supabase → Project Settings → API.
# Unprefixed on purpose: this is only ever read on the server, and a
# NEXT_PUBLIC_ name would be frozen into the build instead of read at runtime.
# NEXT_PUBLIC_SUPABASE_URL is still accepted if you already have it set.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Service role key. Server-side only — never referenced from a Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# The one admin credential. Changing it invalidates every signed-in admin cookie.
ADMIN_PASSWORD=

# Timezone the class actually happens in; decides which day a mark belongs to.
CLASS_TIMEZONE=Asia/Kolkata

# Optional: which of the 47 students the instructor is, so the grid can
# point at their own row. Leave blank if the instructor is not on the roster.
ADMIN_ROLL_NO=

# The one origin students are ever sent to. The QR code is built from this, and
# passkeys are bound to its hostname — so changing it later invalidates every
# passkey and the class must register again. Leave unset locally: it falls back
# to VERCEL_PROJECT_PRODUCTION_URL on Vercel, then to the request's own origin.
APP_ORIGIN=
